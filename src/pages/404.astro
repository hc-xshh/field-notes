---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found — Field Notes"
  description="That page does not exist on Field Notes."
  noindex={true}
>
  <div class="page-head">
    <p class="meta">404</p>
    <h1>Nothing at this address</h1>
    <p>The link may be old, or the post may have been renamed. Both of these are still here:</p>
  </div>

  <ul class="archive">
    <li>
      <a href="/posts/">
        <span class="title">All posts</span>
        <p class="dek">Everything published so far, newest first.</p>
      </a>
    </li>
    <li>
      <a href="/">
        <span class="title">Home</span>
        <p class="dek">What this site is for, and what stays out of it.</p>
      </a>
    </li>
  </ul>
</Base>
