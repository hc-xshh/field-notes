---
import Base from '../../layouts/Base.astro';
import Newsletter from '../../components/Newsletter.astro';
import Toc from '../../components/Toc.astro';
import { getCollection, render } from 'astro:content';
import { formatDate, readingTime, sortByDate } from '../../lib/posts';
import { topicName } from '../../lib/topics';
import { tagName } from '../../lib/tags';

export async function getStaticPaths() {
  const posts = sortByDate(await getCollection('posts', ({ data }) => !data.draft));
  return posts.map((post, index) => ({
    params: { id: post.id },
    props: { post, newer: posts[index - 1] ?? null, older: posts[index + 1] ?? null },
  }));
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);

const postUrl = new URL(`/posts/${post.id}/`, Astro.site).href;
// How often a living page is re-read, in the words the reader sees.
const cadenceLabel: Record<string, string> = {
  weekly: 're-checked weekly',
  monthly: 're-checked monthly',
  quarterly: 're-checked quarterly',
  annual: 're-checked yearly',
  'on-change': 're-checked when the rule changes',
};
const schema = {
  '@type': 'BlogPosting',
  '@id': `${postUrl}#article`,
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  // A living page that has been re-checked is a modified page; saying so is the
  // point of keeping the date.
  dateModified: (post.data.updated ?? post.data.data_checked ?? post.data.date).toISOString(),
  inLanguage: post.data.lang === 'zh' ? 'zh' : 'en',
  // The site is pseudonymous, so the byline is the author name we have —
  // better an honest pen name than an invented person.
  author: { '@type': 'Person', name: 'Field Notes' },
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
  url: postUrl,
  isPartOf: { '@id': `${Astro.site.href}#website` },
};
---

<Base
  title={`${post.data.title} — Field Notes`}
  description={post.data.description}
  kind="article"
  schema={schema}
  ogImage={`/og/${post.id}.png`}
  lang={post.data.lang}
>
  <article>
    <header class="post-head">
      <p class="badge-row">
        <a class="badge" href={`/topics/${post.data.topic}/`}>{topicName(post.data.topic)}</a>
        {post.data.tags.map((tag) => (
          <a class="badge tag" href={`/tags/${tag}/`}>{tagName(tag)}</a>
        ))}
      </p>
      <p class="meta">
        {formatDate(post.data.date)}<span class="sep">·</span>{readingTime(post.body)}
        {post.data.lang === 'zh' && <><span class="sep">·</span>中文</>}
      </p>
      <h1>{post.data.title}</h1>
      <p class="dek">{post.data.description}</p>
      {post.data.refresh && (
        <p class="living">
          Living page — numbers read from the sources on {formatDate(post.data.data_checked ?? post.data.date)}, {cadenceLabel[post.data.refresh]}.
        </p>
      )}
    </header>

    <Toc headings={headings} />

    <div class="prose">
      <Content />
    </div>

    <footer class="post-foot">
      <nav class="post-nav">
        {older && <a href={`/posts/${older.id}/`}>← {older.data.title}</a>}
        {newer && <a href={`/posts/${newer.id}/`}>{newer.data.title} →</a>}
      </nav>
      <p class="post-nav-more">
        <a href={`/topics/${post.data.topic}/`}>More in {topicName(post.data.topic)}</a>
        <span class="sep">·</span>
        <a href="/posts/">All posts</a>
      </p>
    </footer>
  </article>

  <Newsletter />
</Base>
