---
import '../styles/global.css';

const {
  title = 'Field Notes',
  description = 'Notes on building, testing and shipping AI tooling — written from China, for a global audience.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- MailerLite Universal -->
    <script is:inline>
      (function (w, d, e, u, f, l, n) {
        w[f] = w[f] || function () { (w[f].q = w[f].q || []).push(arguments); };
        l = d.createElement(e); l.async = 1; l.src = u;
        n = d.getElementsByTagName(e)[0]; n.parentNode.insertBefore(l, n);
      })(window, document, 'script', 'https://assets.mailerlite.com/js/universal.js', 'ml');
      ml('account', '2692872');
    </script>
    <!-- End MailerLite Universal -->
  </head>
  <body>
    <div class="wrap">
      <header>
        <a class="brand" href="/">Field Notes</a>
        <nav>
          <a href="/posts/">Posts</a>
          <a href="/about/">About</a>
          <a href="/support/">Support</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer>
        <p>Field Notes — written by hand, no newsletter spam, unsubscribe in one click.</p>
      </footer>
    </div>
  </body>
</html>
