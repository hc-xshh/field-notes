---
import '../styles/global.css';

const {
  title = 'Field Notes',
  description = 'Notes on building, testing and shipping AI tooling — written from China, for a global audience.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="wrap">
      <header>
        <a class="brand" href="/">Field Notes</a>
        <nav>
          <a href="/posts/">Posts</a>
          <a href="/about/">About</a>
          <a href="/support/">Support</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer>
        <p>Field Notes — written by hand, no newsletter spam, unsubscribe in one click.</p>
      </footer>
    </div>
  </body>
</html>
