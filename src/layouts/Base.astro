---
import '../styles/global.css';

const {
  title = 'Field Notes',
  description = 'Notes on building, testing and shipping AI tooling — written from China, for a global audience.',
  kind = 'website',
  schema = null,
  noindex = false,
} = Astro.props;

const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site).href;

// Every page carries a WebSite node; a page can pass its own extra node
// (the article page passes a BlogPosting). Plain JSON-LD, no build step.
const graph = [
  {
    '@type': 'WebSite',
    '@id': `${Astro.site.href}#website`,
    name: 'Field Notes',
    url: Astro.site.href,
    description,
    inLanguage: 'en',
  },
  ...(schema ? (Array.isArray(schema) ? schema : [schema]) : []),
];
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });

const nav = [
  { href: '/posts/', label: 'Posts' },
  { href: '/about/', label: 'About' },
  { href: '/support/', label: 'Support' },
];

const isCurrent = (href) => path === href || (href !== '/' && path.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={kind} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Field Notes" />
    <meta name="twitter:card" content="summary" />
    {noindex && <meta name="robots" content="noindex" />}

    <script type="application/ld+json" set:html={jsonLd} />

    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101013" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Field Notes" href="/rss.xml" />

    <!-- Set the theme before first paint so there is no flash of the wrong mode. -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'dark' || saved === 'light') {
            document.documentElement.dataset.theme = saved;
          }
        } catch (e) {}
      })();
    </script>

    <!-- MailerLite Universal -->
    <script is:inline>
      (function (w, d, e, u, f, l, n) {
        w[f] = w[f] || function () { (w[f].q = w[f].q || []).push(arguments); };
        l = d.createElement(e); l.async = 1; l.src = u;
        n = d.getElementsByTagName(e)[0]; n.parentNode.insertBefore(l, n);
      })(window, document, 'script', 'https://assets.mailerlite.com/js/universal.js', 'ml');
      ml('account', '2692872');
    </script>
    <!-- End MailerLite Universal -->
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="wrap">
      <header class="masthead">
        <a class="brand" href="/">Field Notes <small>AI tooling, tested</small></a>
        <nav>
          {nav.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
          <button class="theme-toggle" type="button" aria-label="Switch colour theme" title="Switch colour theme">
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
            </svg>
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
          </button>
        </nav>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="site-foot">
        <p>Field Notes — written by hand, no newsletter spam, unsubscribe in one click.</p>
        <p class="colophon">Built with Astro · Hosted on Cloudflare Pages · <a href="/rss.xml">RSS</a></p>
      </footer>
    </div>

    <script is:inline>
      (function () {
        var btn = document.querySelector('.theme-toggle');
        if (!btn) return;
        var media = window.matchMedia('(prefers-color-scheme: dark)');
        function current() {
          return document.documentElement.dataset.theme || (media.matches ? 'dark' : 'light');
        }
        function label() {
          btn.setAttribute('aria-label', current() === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
        }
        btn.addEventListener('click', function () {
          var next = current() === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch (e) {}
          label();
        });
        label();
      })();
    </script>
  </body>
</html>
